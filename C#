Imports System.Windows
Imports System.Windows.Controls
Imports System.Windows.Input
Imports System.Collections.Generic
Imports System.Windows.Shapes

Namespace AdoptMe

    Partial Public Class MainWindow
        Inherits Window

        Private petDescriptions As New Dictionary(Of String, String)()
        Private reservations As New List(Of String)()

        Public Sub New()
            InitializeComponent()

            petDescriptions("Kapcio") = "Kapcio - Bardzo grożny"
            petDescriptions("Lexio") = "Lexio - bardzo energetyczny"
            petDescriptions("Macio") = "Macio - Śpi 24/7"
            petDescriptions("Arturcio") = "Arturcio - pije cole"
            petDescriptions("Romcio") = "Romcio - bardzo inteligentny"
            petDescriptions("Filipcio") = "Filipcio - spóznia się na wszystko, leniwy"
            petDescriptions("Michcio") = "Michcio - nasza główna wizytówka"
            petDescriptions("Sebcio") = "Sebcio - raz jest raz go ni ma"
            petDescriptions("Czario") = "Czario - bardzo zabiegły gość, 3 lata, uwielbia towarzystwo innych zwierząt."
        End Sub

        Private Sub PetImage_Click(sender As Object, e As MouseButtonEventArgs)

            Dim img = TryCast(sender, Image)
            If img Is Nothing Then Return

            Dim key As String = If(img.Tag IsNot Nothing, img.Tag.ToString(), String.Empty)
            If String.IsNullOrEmpty(key) Then Return

            txtPetName.Text = key
            Dim desc As String = If(petDescriptions.ContainsKey(key), petDescriptions(key), "Information not available.")
            txtPetDescription.Text = desc
            previewImage.Source = img.Source

            InfoCard.Visibility = Visibility.Visible
        End Sub

        Private Sub BtnConfirm_Click(sender As Object, e As RoutedEventArgs)
            Dim name = txtPetName.Text
            If String.IsNullOrEmpty(name) Then
                MessageBox.Show("No pet selected.", "Error", MessageBoxButton.OK, MessageBoxImage.Error)
                Return
            End If


            If Not reservations.Contains(name) Then
                reservations.Add(name)


                Dim strikeName = "strike_" & name
                Dim strikeObj = TryCast(FindName(strikeName), Line)
                If strikeObj IsNot Nothing Then
                    strikeObj.Visibility = Visibility.Visible
                End If


                Dim imgName = "img" & name
                Dim petImg = TryCast(FindName(imgName), Image)
                If petImg IsNot Nothing Then
                    petImg.Opacity = 0.5
                    petImg.IsEnabled = False
                    petImg.Cursor = Cursors.Arrow
                End If
            End If

            MessageBox.Show(String.Format("{0} zarezerwowany. Dziekuje!", name), "Rezerwacja", MessageBoxButton.OK, MessageBoxImage.Information)
            InfoCard.Visibility = Visibility.Collapsed
        End Sub

        Private Sub BtnClose_Click(sender As Object, e As RoutedEventArgs)
            InfoCard.Visibility = Visibility.Collapsed
        End Sub
    End Class

End Namespace
