<Window x:Class="AdoptMe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdoptMe"
        mc:Ignorable="d"
        Title="MainWindow" Height="932" Width="1108">
    <Grid Background="#FF462A38" Margin="0,0,0,-152">
        <Grid.RowDefinitions>
            <RowDefinition Height="31*"/>
            <RowDefinition Height="47*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zaadoptuj mnie!" Margin="240,10,-184,278" FontSize="70px" Foreground="#FFAEC9" FontFamily="Cooper Black"/>

        <Grid Margin="49,127,831,151">
            <Image x:Name="imgKapcio" Tag="Kapcio" Source="/Images/kapcio.jpg" Stretch="Fill" Cursor="Hand" MouseLeftButtonUp="PetImage_Click"/>
            <Line x:Name="strike_Kapcio" X1="0" Y1="0" X2="1" Y2="1" Stroke="Red" StrokeThickness="8" Visibility="Collapsed" Stretch="Fill" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>

        <Grid Margin="536,119,329,172">
            <Image x:Name="imgLexio" Tag="Lexio" Source="/Images/lexio.jpg" Stretch="Fill" Cursor="Hand" MouseLeftButtonUp="PetImage_Click"/>
            <Line x:Name="strike_Lexio" X1="0" Y1="0" X2="1" Y2="1" Stroke="Red" StrokeThickness="8" Visibility="Collapsed" Stretch="Fill" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>

        <Grid Margin="814,122,81,172">
            <Image x:Name="imgMacio" Tag="Macio" Source="/Images/macio.jpg" Stretch="Fill" Cursor="Hand" MouseLeftButtonUp="PetImage_Click"/>
            <Line x:Name="strike_Macio" X1="0" Y1="0" X2="1" Y2="1" Stroke="Red" StrokeThickness="8" Visibility="Collapsed" Stretch="Fill" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
        <Grid Margin="42,24,838,411" Grid.Row="1">
            <Image x:Name="imgArturcio" Tag="Arturcio" Source="/Images/arturcio.jpg" Stretch="Fill" Cursor="Hand" MouseLeftButtonUp="PetImage_Click"/>
            <Line x:Name="strike_Arturcio" X1="0" Y1="0" X2="1" Y2="1" Stroke="Red" StrokeThickness="8" Visibility="Collapsed" Stretch="Fill" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>

        <Grid Margin="783,29,61,411" Grid.Row="1">
            <Image x:Name="imgRomcio" Tag="Romcio" Source="/Images/romcio.jpg" Stretch="Fill" Cursor="Hand" MouseLeftButtonUp="PetImage_Click"/>
            <Line x:Name="strike_Romcio" X1="0" Y1="0" X2="1" Y2="1" Stroke="Red" StrokeThickness="8" Visibility="Collapsed" Stretch="Fill" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>

        <Grid Margin="536,29,360,411" Grid.Row="1">
            <Image x:Name="imgFilipcio" Tag="Filipcio" Source="/Images/filippo.png" Stretch="Fill" Cursor="Hand" MouseLeftButtonUp="PetImage_Click"/>
            <Line x:Name="strike_Filipcio" X1="0" Y1="0" X2="1" Y2="1" Stroke="Red" StrokeThickness="8" Visibility="Collapsed" Stretch="Fill" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>


        <Grid Margin="174,385,174,54" Grid.Row="1">
            <Image x:Name="imgMichcio" Tag="Michcio" Source="/Images/michaul.png" Stretch="UniformToFill" Width="120" Height="120" Cursor="Hand" MouseLeftButtonUp="PetImage_Click"/>
            <Line x:Name="strike_Michcio" X1="0" Y1="0" X2="1" Y2="1" Stroke="Red" StrokeThickness="8" Visibility="Collapsed" Stretch="Fill" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
        
        
        <Grid Margin="303,29,600,411" Grid.Row="1">
        <Image x:Name="imgCzario" Source="/Images/Czario.jpg" Tag="Czario" Stretch="Fill"  Grid.Row="1" Cursor="Hand" MouseLeftButtonUp="PetImage_Click" />
            <Line x:Name="strike_Czario" X1="0" Y1="0" X2="1" Y2="1" Stroke="red" StrokeThickness="8" Visibility="Collapsed" Stretch="Fill" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
        
        <Grid Margin="304,131,0,0">
            <Image x:Name="imgSebcio" Tag="Sebcio" Source="/Images/Sebcio.jpg" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Left" Height="142" Width="208" RenderTransformOrigin="0.5,0.5" Cursor="Hand" MouseLeftButtonUp="PetImage_Click">
                <Image.RenderTransform>
                    <TransformGroup/>
                </Image.RenderTransform>
            </Image>
            <Line x:Name="strike_Sebcio" X1="0" Y1="0" X2="1" Y2="1" Stroke="Red" StrokeThickness="8" Visibility="Collapsed" Stretch="Fill" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>


        <Grid Margin="328,209,600,291" Grid.Row="1">
            <TextBlock x:Name="lblCzario" FontSize="48" FontFamily="Viner Hand ITC" Foreground="#FFBC6DC5" VerticalAlignment="Center" HorizontalAlignment="Left">Czario</TextBlock>
        </Grid>

        <TextBlock FontSize="48" Margin="58,273,676,35" FontFamily="Viner Hand ITC" Foreground="#FFBC6DC5">Kapcio</TextBlock>
        <TextBlock FontSize="48" Margin="321,274,413,34" FontFamily="Viner Hand ITC" Foreground="#FFBC6DC5">Sebcio</TextBlock>
        <TextBlock FontSize="48" Margin="592,273,142,34" FontFamily="Viner Hand ITC" Foreground="#FFBC6DC5">Lexio</TextBlock>
        <TextBlock FontSize="48" Margin="860,274,-126,34" FontFamily="Viner Hand ITC" Foreground="#FFBC6DC5">Macio</TextBlock>
        <TextBlock FontSize="48" Margin="64,242,838,258" FontFamily="Viner Hand ITC" Foreground="#FFBC6DC5" Grid.Row="1">Arturcio</TextBlock>
        <TextBlock FontSize="48" Margin="566,242,342,259" FontFamily="Viner Hand ITC" Foreground="#FFBC6DC5" Grid.Row="1">Filipcio</TextBlock>
        <TextBlock FontSize="48" Margin="820,242,81,258" FontFamily="Viner Hand ITC" Foreground="#FFBC6DC5" Grid.Row="1">Romcio</TextBlock>
        <TextBlock FontSize="48" Margin="222,416,466,85" FontFamily="Viner Hand ITC" Foreground="#FFBC6DC5" Grid.Row="1">Michcio</TextBlock>
        <TextBlock FontSize="34" Margin="642,447,46,54" FontFamily="Viner Hand ITC" Foreground="#FFBC6DC5" Grid.Row="1" LineHeight="6">Daria Sluzhynska <LineBreak/> Weronika Wicka</TextBlock>


        <Border x:Name="InfoCard" Background="#EEFFFFFF" BorderBrush="#FF5A2E3A" BorderThickness="2" CornerRadius="8" Padding="12" Width="420" Height="260" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="99">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="previewImage" Grid.Column="0" Margin="4" Stretch="UniformToFill" Width="120" Height="120"/>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock x:Name="txtPetName" FontSize="22" FontWeight="Bold" Foreground="#FF462A38"/>
                    <TextBlock x:Name="txtPetDescription" TextWrapping="Wrap" Margin="0,6,0,12" Foreground="#FF462A38"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnConfirm" Content="Confirm reservation" Margin="4,0" Padding="8,4" Click="BtnConfirm_Click"/>
                        <Button x:Name="btnClose" Content="Close" Margin="4,0" Padding="8,4" Click="BtnClose_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
